data/
__pycache__/
*.pyc
.venv/
.DS_Store
.Rhistory

# Outputs are regenerated by the scripts and are not committed, except for the
# figures and tables the README points at. Result 2's outputs are committed as well
# because they are the only way a reader without a WRDS subscription can see the
# replication check.
output/*
!output/fig02_decay.png
!output/result1_summary.txt
!output/result1_windows.csv
!output/fig04_rebuild.png
!output/rebuild_summary.txt
!output/rebuild_Size.csv
!output/rebuild_Mom12m.csv

# Script backups
*.bak_*

# Quarto build products. The .qmd is the source; the intermediate render and the
# generated notebook are not committed.
paper/_output/
paper/_freeze/
paper/.quarto/
paper/*.ipynb
.quarto/

# docs/ is NOT ignored. It holds the single self-contained HTML that GitHub Pages
# serves, produced by paper/publish.sh. Committing a build artefact is deliberate
# here: the render needs the Chen-Zimmermann files, which are not redistributable
# and so are not in the repo, which means no CI job could rebuild the page.

# A private working file: six method questions to answer in writing. The answers now
# live in paper/alpha-decay.qmd, where they are argued rather than listed, so the
# worksheet itself is not part of the published project.
DECISIONS.md

# Two working files that are not part of this project. PROFILE_README.md is a draft of
# a GitHub profile page and belongs in the profile repository; GIT_GUIDE.md is a git
# tutorial written while setting this up. Neither is about alpha decay.
PROFILE_README.md
GIT_GUIDE.md
